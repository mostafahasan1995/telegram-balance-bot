# The Docker build context. Everything listed here never reaches the image build.
#
# Why each group is excluded:

# Host-installed dependencies and build output. The image installs its own dependencies from
# bun.lock inside Linux; copying a Windows/macOS node_modules would smuggle in the wrong native
# binaries (rolldown, lightningcss, tailwind oxide are all platform-specific) and make the build
# depend on whatever happens to be on the developer's disk.
node_modules
.output
dist
dist-ssr
.nitro
.vinxi
.tanstack
.wrangler

# package-lock.json is NOT the lockfile of this project. bun.lock is the committed one; an npm lock
# left over from a local `npm install` is untracked noise and must never decide what gets built.
package-lock.json

# Lovable's project metadata. Read (checked in node_modules/@lovable.dev/vite-tanstack-config):
# the build only WRITES .lovable/output.json, and only inside a Lovable sandbox (LOVABLE_SANDBOX=1
# or DEV_SERVER__PROJECT_PATH set), which a Docker build never is. Nothing reads project.json.
.lovable

# Version control, CI and editor state: not inputs to the build, and .git would bust the layer
# cache on every commit.
.git
.gitignore
.gitattributes
.github
.vscode
.idea
*.suo
*.sw?
.DS_Store

# Secrets and local overrides must never enter a build context (they would end up in a layer).
.env
.env.*
.dev.vars
*.local

# Logs and docs.
*.log
logs
README.md
AGENTS.md

# The image recipe itself: changing it should not invalidate the `COPY . .` layer.
Dockerfile
.dockerignore
